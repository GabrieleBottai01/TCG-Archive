# Postgres (Neon). Get these from your Neon project dashboard.
# DATABASE_URL = the POOLED connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# DIRECT_URL = the DIRECT connection string (no "-pooler"). Used by Prisma CLI (db push / seed).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require"

# Optional: higher rate limits for automatic Pokémon prices.
POKEMONTCGIO_API_KEY=""

# Auth.js
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
